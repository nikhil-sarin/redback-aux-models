redshift = Uniform(0.001, 0.3, 'redshift', latex_label = r'$z$')
core_radius = LogUniform(1e12, 1e14, 'core_radius', latex_label = r'$R_{\mathrm{core}}~(\mathrm{cm})$')
core_mass = LogUniform(1e-1, 50, 'core_mass', latex_label = r'$M_{\mathrm{core}}~(M_\odot)$')
core_recombination_temperature = Uniform(0, 10000, 'core_recombination_temperature', latex_label = r'$T_{\mathrm{rec\ core}}~(\mathrm{K})$')
nickel_mass = LogUniform(1e-4, 1, 'nickel_mass', latex_label = r'$M_{\mathrm{Ni}}~(M_\odot)$')
core_kinetic_energy = LogUniform(1e-2, 10, 'core_kinetic_energy', latex_label = r'$E_{\mathrm{kin\ core}}~(10^{51}~\mathrm{erg})$')
core_thermal_energy = LogUniform(1e-3, 10, 'core_thermal_energy', latex_label = r'$E_{\mathrm{th\ core}}~(10^{51}~\mathrm{erg})$')
core_exponential_density = DeltaFunction(0, 'core_exponential_density', latex_label = r'$a_{\mathrm{core}}$')
core_powerlaw_density = DeltaFunction(0, 'core_powerlaw_density', latex_label = r'$n_{\mathrm{core}}$')
core_kappa = Uniform(0.05, 1, 'core_kappa', latex_label = r'$\kappa_{\mathrm{core}}~(\mathrm{cm}^{2}~\mathrm{g}^{-1})$')
core_gamma_leakage = DeltaFunction(3e5, 'core_gamma_leakage', latex_label = r'$A_{\gamma\ core}~(\mathrm{d}^{2})$')
shell_radius = LogUniform(1e12, 1e14, 'shell_radius', latex_label = r'$R_{\mathrm{shell}}~(\mathrm{cm})$')
shell_mass = LogUniform(1e-3, 5, 'shell_mass', latex_label = r'$M_{\mathrm{shell}}~(M_\odot)$')
shell_recombination_temperature = DeltaFunction(0, 'shell_recombination_temperature', latex_label = r'$T_{\mathrm{rec\ shell}}~(\mathrm{K})$')
shell_kinetic_energy = LogUniform(1e-3, 10, 'shell_kinetic_energy', latex_label = r'$E_{\mathrm{kin\ shell}}~(10^{51}~\mathrm{erg})$')
shell_thermal_energy = LogUniform(1e-4, 1, 'shell_thermal_energy', latex_label = r'$E_{\mathrm{th\ shell}}~(10^{51}~\mathrm{erg})$')
shell_exponential_density = DeltaFunction(0, 'shell_exponential_density', latex_label = r'$a_{\mathrm{shell}}$')
shell_powerlaw_density = DeltaFunction(2, 'shell_powerlaw_density', latex_label = r'$n_{\mathrm{shell}}$')
shell_kappa = Uniform(0.05, 1, 'shell_kappa', latex_label = r'$\kappa_{\mathrm{shell}}~(\mathrm{cm}^{2}~\mathrm{g}^{-1})$')
shell_gamma_leakage = DeltaFunction(1e10, 'shell_gamma_leakage', latex_label = r'$A_{\gamma\ shell}~(\mathrm{d}^{2})$')
magnetar_energy = DeltaFunction(0, 'magnetar_energy', latex_label = r'$E_{\mathrm{p}}~(10^{51}~\mathrm{erg})$')
magnetar_timescale = DeltaFunction(0, 'magnetar_timescale', latex_label = r'$t_{\mathrm{p}}~(\mathrm{d})$')
temperature_floor = LogUniform(1000, 10000, 'temperature_floor', latex_label = r'$T_{\mathrm{floor}}~(\mathrm{K})$')
